% Type checker of Linear A (Figure 4)
%

accumulate linA.

% ---------------------------------------------------------------------------
% Type checker (Figure 4)
% ---------------------------------------------------------------------------

namespace lincheckA {

shorten linA.{
  ty, r, tup, val, real, vtup, nl, lin, fn, nbind, nb, nend, lbind, lb, lend,
  expr, ret, let, unpack, lunpack, app, nvar, lit, tuple, plus, mul, lvar,
  lzero, ltuple, lplus, lmul, dup, drop, fbody, body, prog, def, pnil }.
shorten linA.{ sin, cos, exp, neg }.

%
% Γ ; Γ̇ ⊢ e : (τ ; τ̇) is  of E Ts LTs.
%
% Each variable in scope carries a usage mark, a fresh unification variable
% set to `used` when the variable occurs. When a binder goes out of scope we
% require the mark to be set. Non-linear variables may be marked many times
% (Γ1 ∪ Γ2: used at least once); linear ones must be unmarked when used
% (Γ̇1 ⊎ Γ̇2: used exactly once).

data mark.
symb used mark.

% [nlty X T M] the type T and usage mark M of the non-linear variable X
% (loaded with ==> when X is bound)
func nlty  nl  -> ty, mark.
% [linty X T M] the type T and usage mark M of the linear variable X (loaded
% with ==> when X is bound)
func linty lin -> ty, mark.
% [fnty F Ts LTs Ss LSs] the function F takes (Ts ; LTs) and returns
% (Ss ; LSs) (loaded with ==> by of-prog after the definition of F)
func fnty  fn  -> list ty, list ty, list ty, list ty.

% [use-nl V T] V is a non-linear variable of type T in scope, and gets
% marked as used (it may already be).
func use-nl nl -> ty.
use-nl V T :- nlty V T M, M = used.

% [use-lin V T] V is a linear variable of type T in scope, not used yet, and
% gets marked as used, so a second use fails.
func use-lin lin -> ty.
use-lin V T :- linty V T M, var M, M = used.

% [of-nb B K Ts LTs] brings the binders of B into scope, checks their types
% against Ts (non-linear) and LTs (linear), runs K on the body, then checks
% that every bound variable was used.
func of-nb nbind A, (func A) -> list ty, list ty.
of-nb (nend L) K [] LTs :- of-lb L K LTs.
of-nb (nb T B) K [T|Ts] LTs :-
  pi x\ nlty x T M ==> of-nb (B x) K Ts LTs, not (var M).

% [of-lb B K Ts] like of-nb, for the linear spine B, whose binders have types
% Ts.
func of-lb lbind A, (func A) -> list ty.
of-lb (lend X) K [] :- K X.
of-lb (lb T B) K [T|Ts] :-
  pi x\ linty x T M ==> of-lb (B x) K Ts, not (var M).

% [of E Ts LTs] E has type (Ts ; LTs), that is Γ ; Γ̇ ⊢ e : (τ ; τ̇) where Γ
% and Γ̇ are the variables in scope. It marks the variables E uses.
func of expr -> list ty, list ty.

of (ret Vs LVs) Ts LTs :- % TypeRet
  std.map Vs use-nl Ts, std.map LVs use-lin LTs.

of (let E1 B) Ss LSs :- % TypeLet
  of E1 Ts LTs,
  of-nb B (e2\ of e2 Ss LSs) Ts LTs.

of (unpack V B) Ss LSs :- % TypeUnpack
  use-nl V (tup Ts), of-nb B (e\ of e Ss LSs) Ts [].

of (lunpack V B) Ss LSs :- % TypeLinUnpack
  use-lin V (tup Ts), of-lb B (e\ of e Ss LSs) Ts.

of (app F Vs LVs) Ss LSs :- % TypeApp
  fnty F Ts LTs Ss LSs,
  std.map Vs use-nl Ts, std.map LVs use-lin LTs.

of (nvar V) [T] [] :- % TypeVar
  use-nl V T.

of (lit _) [r] []. % TypeLit

of (sin V) [r] [] :- % TypePrim1
  use-nl V r.
of (cos V) [r] [] :- % TypePrim1
  use-nl V r.
of (exp V) [r] [] :- % TypePrim1
  use-nl V r.
of (neg V) [r] [] :- % TypePrim1
  use-nl V r.

of (plus V1 V2) [r] [] :- % TypePrim2
  use-nl V1 r, use-nl V2 r.
of (mul  V1 V2) [r] [] :- % TypePrim2
  use-nl V1 r, use-nl V2 r.

of (tuple Vs) [tup Ts] [] :- % TypeTup
  std.map Vs use-nl Ts.

of (ltuple Vs) [] [tup Ts] :- % TypeLinTup
  std.map Vs use-lin Ts.

of (lvar V) [] [T] :- % TypeLinVar
  use-lin V T.

of (lzero T) [] [T]. % TypeLinZero

of (lplus V1 V2) [] [T] :- % TypeLinPlus
  use-lin V1 T, use-lin V2 T.

of (lmul V1 V2) [] [T] :- % TypeLinMul
  use-nl V1 r, use-lin V2 T.

of (dup V) [] [T, T] :- % TypeDup
  use-lin V T.

of (drop E) [] [] :- % TypeDrop
  of E _ _.

% [of-def D Ts LTs Ss LSs] the definition D takes (Ts ; LTs) and returns
% (Ss ; LSs) (rule TypeDef).
func of-def nbind fbody -> list ty, list ty, list ty, list ty.
of-def D Ts LTs Ss LSs :- % TypeDef
  of-nb D (b\ of-body b Ss LSs) Ts LTs.

% [of-body B Ss LSs] the expression of the definition body B has the return
% types (Ss ; LSs) that B declares.
func of-body fbody -> list ty, list ty.
of-body (body Ss LSs E) Ss LSs :- of E Ss LSs.

% [of-prog P] every definition of P is well typed: each is checked, then its
% name is brought into scope for the following ones.
func of-prog prog.
of-prog pnil.
of-prog (def D P) :-
  of-def D Ts LTs Ss LSs,
  pi f\ fnty f Ts LTs Ss LSs ==> of-prog (P f).

} % namespace lincheckA
