% The running example of the paper, f(u) = −sin(u), through every step:
% J, U, T and L. running.show prints each step in the paper's notation,
% type-checks it, and runs it with its cost.

accumulate linA.
accumulate linB.
accumulate lincheckA.
accumulate evalA.
accumulate ppA.
accumulate ppB.
accumulate forward.
accumulate flatten.
accumulate copyprop.
accumulate erase.
accumulate unzip.
accumulate transpose.
accumulate examples.

% ---------------------------------------------------------------------------
% The running example of the paper: f(u) = −sin(u)
% ---------------------------------------------------------------------------

namespace running {

shorten linA.{ r, real, def, pnil }.

func step string.
step S :- print "", print "==" S "==", print "".

func show-types linA.prog.
show-types P :- lincheckA.of-prog P, print "(type-checks in Linear A)".

func show.
show :-
  print "Running example: f(u) = −sin(u), at u = 0.5",
  step "f, in Linear A (Figure 6, left)",
  example.neg-sin F, P = def F (x\ pnil),
  ppA.prog->string P SF, print SF, show-types P,
  evalA.run P [real 0.5] [] O0 _ C0,
  print "f(0.5 ;) =" O0 "cost" C0,

  step "J(f): forward derivative, as the rules of Figure 7 produce it",
  forward.dj-prog P PJ0,
  ppA.prog->string PJ0 SJ0, print SJ0, show-types PJ0,
  evalA.run PJ0 [real 0.5] [real 1.0] O1 L1 C1,
  print "f^J(0.5 ; 1) =" O1 L1 "cost" C1,

  step "C, part 1, flatten: nested lets floated out",
  flatten.flatten-prog PJ0 PJ1,
  ppA.prog->string PJ1 SJ1, print SJ1, show-types PJ1,

  step "C, part 2, copyprop: copies propagated; C(J(f)) is Figure 6, right",
  copyprop.copyprop-prog PJ1 PJ,
  ppA.prog->string PJ SJ, print SJ, show-types PJ,
  evalA.run PJ [real 0.5] [real 1.0] O1' L1' C1',
  print "f^J(0.5 ; 1) =" O1' L1' "cost" C1' " (same as before the two steps)",

  step "U(C(J(f))): unzipped into Linear B (Figure 9)",
  unzip.unzip-prog PJ PU,
  ppB.prog->string PU SU, print SU,
  linB.to-linA PU AU, show-types AU,
  linA.drop-last AU AN,
  evalA.run AN [real 0.5] [] O2 _ C2,
  print "f^J.nonlin(0.5 ;) =" O2 "cost" C2,
  std.rev O2 [Tape|_],
  evalA.run AU [Tape] [real 1.0] _ L3 C3,
  print "f^J.lin(tape ; 1) =" L3 "cost" C3,

  step "T(U(C(J(f)))): f^J.lin transposed (Figure 10); reverse mode",
  transpose.transpose-prog PU PT,
  ppB.tprog->string PT ST, print ST,
  linB.to-linA PT AT, show-types AT,
  evalA.run AT [Tape] [real 1.0] _ L5 C5,
  print "f^J.linᵀ(tape ; 1) =" L5 "cost" C5 " (the gradient f'(0.5) = −cos(0.5))",

  step "L(C(J(f))): linearity erasure, F and F' with no linear code (Section 5)",
  erase.lerase-prog PJ PE,
  ppA.prog->string PE SE, print SE, show-types PE,
  evalA.run PE [real 0.5, real 1.0] [] O4 _ C4,
  print "L(f^J)(0.5, 1 ;) =" O4 "cost" C4.

} % namespace running
