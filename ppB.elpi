% Pretty printer of Linear B, in the notation of the paper
%
% Same conventions as ppA.elpi, whose helpers it reuses (names, types,
% leaves, layout). A non-linear function f defined right before a linear
% one is printed as f.nonlin, and the linear one as f.lin, as in Figure 9.

accumulate linA.
accumulate linB.
accumulate ppA.

namespace ppB {

shorten linB.{
  nexpr, lexpr, nabs, labs, ret, let, unpack, app, drop, leaf, lret, llet,
  nlet, lunpack, nunpack, lapp, ldrop, lleaf, nb, nend, lb, lend, nfbody,
  lfbody, nbody, lbody, ndef, ldef, pnil, prog, nfn, lfn }.
shorten ppA.{
  var-name, fn-name, dotted, pp-ty, pp-tensor, pp-split, pp-decl, indent,
  pp-let, pp-drop, pp-atom, pp-sep, nlname, linname }.

% [nfname F S] S is the name of the non-linear function F, loaded in the context
% when F is bound.
func nfname nfn -> string.
% [lfname F S] S is the name of the linear function F, loaded in the context
% when F is bound.
func lfname lfn -> string.

% [pp-nabs K N B Xs Ts Body] names the non-linear binders of the spine B from
% depth N, then prints the body of B with K, at the depth past the binders, into
% the lines Body. Xs and Ts are the names and types of the binders.
func pp-nabs (func A, int -> list string), int, nabs A
  -> list string, list string, list string.
pp-nabs K N (nb T B) [X|Xs] [TS|Ts] Body :-
  var-name N X, pp-ty T TS, N1 is N + 1,
  pi x\ nlname x X ==> pp-nabs K N1 (B x) Xs Ts Body.
pp-nabs K N (nend A) [] [] Body :- K A N Body.

% [pp-labs K N B Xs Ts Body] is pp-nabs for a spine B of linear binders.
func pp-labs (func A, int -> list string), int, labs A
  -> list string, list string, list string.
pp-labs K N (lb T B) [X|Xs] [TS|Ts] Body :-
  var-name N X0, dotted X0 X, pp-ty T TS, N1 is N + 1,
  pi x\ linname x X ==> pp-labs K N1 (B x) Xs Ts Body.
pp-labs K N (lend A) [] [] Body :- K A N Body.

% [past N Xs N1] N1 is N plus the length of Xs: the bound expression of a let is
% numbered past the let's own binders Xs.
func past int, list string -> int.
past N Xs N1 :- std.length Xs K, N1 is N + K.

% [pp-n E N Lines] Lines print the non-linear expression E, naming its binders
% from depth N.
func pp-n nexpr, int -> list string.
pp-n (ret Vs) _ [S] :- !, std.map Vs nlname Xs, pp-split Xs [] S.
pp-n (let E B) N Lines :- !,
  pp-nabs pp-n N B Xs Ts Body, past N Xs N1, pp-n E N1 L1,
  std.map2 Xs Ts pp-decl Ds, pp-split Ds [] Head, pp-let Head L1 Body Lines.
pp-n (unpack V B) N Lines :- !,
  nlname V X, pp-nabs pp-n N B Xs Ts Body, pp-tensor Xs P, pp-tensor Ts PT,
  Head is "(" ^ P ^ " : " ^ PT ^ " ;)", pp-let Head [X] Body Lines.
pp-n (app F Vs) _ [S] :- !,
  nfname F Fn, std.map Vs nlname Xs, pp-split Xs [] A, S is Fn ^ A.
pp-n (drop E) N Lines :- !, pp-n E N L, pp-drop L Lines.
pp-n (leaf E) _ [S] :- pp-atom E S.

% [pp-l E N Lines] Lines print the linear expression E, naming its binders from
% depth N.
func pp-l lexpr, int -> list string.
pp-l (lret Ds) _ [S] :- !, std.map Ds linname Xs, pp-split [] Xs S.
pp-l (llet E B) N Lines :- !,
  pp-labs pp-l N B Xs Ts Body, past N Xs N1, pp-l E N1 L1,
  std.map2 Xs Ts pp-decl Ds, pp-split [] Ds Head, pp-let Head L1 Body Lines.
pp-l (nlet E B) N Lines :- !,
  pp-nabs pp-l N B Xs Ts Body, past N Xs N1, pp-n E N1 L1,
  std.map2 Xs Ts pp-decl Ds, pp-split Ds [] Head, pp-let Head L1 Body Lines.
pp-l (lunpack D B) N Lines :- !,
  linname D X, pp-labs pp-l N B Xs Ts Body, pp-tensor Xs P, pp-tensor Ts PT,
  Head is "(; " ^ P ^ " : " ^ PT ^ ")", pp-let Head [X] Body Lines.
pp-l (nunpack V B) N Lines :- !,
  nlname V X, pp-nabs pp-l N B Xs Ts Body, pp-tensor Xs P, pp-tensor Ts PT,
  Head is "(" ^ P ^ " : " ^ PT ^ " ;)", pp-let Head [X] Body Lines.
pp-l (lapp F Vs Ds) _ [S] :- !,
  lfname F Fn, std.map Vs nlname Xs, std.map Ds linname Ys,
  pp-split Xs Ys A, S is Fn ^ A.
pp-l (ldrop E) N Lines :- !, pp-l E N L, pp-drop L Lines.
pp-l (lleaf E) _ [S] :- pp-atom E S.

% [pp-nbody B N Lines] Lines are the return types of B, as (σ ;), then the lines
% of its expression, named from depth N. The return types come first so that
% pp-ndef can put them in the header.
func pp-nbody nfbody, int -> list string.
pp-nbody (nbody Ss E) N [R|Lines] :-
  std.map Ss pp-ty STs, pp-split STs [] R, pp-n E N Lines.

% [pp-ndef Fn D Lines] Lines print D as the non-linear definition of Fn: a
% header def Fn(v:τ ;) → (σ ;) =, then the body, indented.
func pp-ndef string, nabs nfbody -> list string.
pp-ndef Fn D [Hd|Body] :-
  pp-nabs pp-nbody 0 D Xs Ts [R|Lines],
  std.map2 Xs Ts pp-decl Ds, pp-split Ds [] Args,
  Hd is "def " ^ Fn ^ Args ^ " → " ^ R ^ " =", indent Lines Body.

% [pp-lbody B N Lines] Lines are the return types of B, as (; σ̇), then the
% lines of its expression, named from depth N.
func pp-lbody lfbody, int -> list string.
pp-lbody (lbody Ss E) N [R|Lines] :-
  std.map Ss pp-ty STs, pp-split [] STs R, pp-l E N Lines.

% [pp-lpart LA N Lines] Lines are the linear parameters of LA (their
% declarations joined by commas), the return types, then the lines of the body,
% naming the binders from depth N. The parameters and return types come first so
% that pp-ldef can put them in the header.
func pp-lpart labs lfbody, int -> list string.
pp-lpart LA N [LDS, R|Lines] :-
  pp-labs pp-lbody N LA Xs Ts [R|Lines],
  std.map2 Xs Ts pp-decl LDs, std.string.concat ", " LDs LDS.

% [pp-ldef Fn D Lines] Lines print D as the linear definition of Fn: a header
% def Fn(v:τ ; v̇:τ̇) → (; σ̇) =, then the body, indented.
func pp-ldef string, nabs (labs lfbody) -> list string.
pp-ldef Fn D [Hd|Body] :-
  pp-nabs pp-lpart 0 D Xs Ts [LDS, R|Lines],
  std.map2 Xs Ts pp-decl Ds, lin-args LDS LArgs, pp-split Ds LArgs Args,
  Hd is "def " ^ Fn ^ Args ^ " → " ^ R ^ " =", indent Lines Body.

% [lin-args S Ls] Ls is [S], or [] when S is empty.
func lin-args string -> list string.
lin-args "" [] :- !.
lin-args S [S].

% [pp-prog Lin K Base P Lines] Lines print the definitions of P in order,
% separated by a blank line, the next one named after fn-name K. Lin is the
% suffix of linear functions (".lin", or ".linᵀ" for a transposed program). Base
% is the name of the previous definition when it was non-linear, "" otherwise.
func pp-prog string, int, string, prog -> list string.
pp-prog _ _ _ pnil [].
pp-prog Lin K _ (ndef D P) Lines :-
  fn-name K Base, Fn is Base ^ ".nonlin", pp-ndef Fn D L1, K1 is K + 1,
  (pi f\ nfname f Fn ==> pp-prog Lin K1 Base (P f) L2),
  pp-sep L1 L2 Lines.
pp-prog Lin K Base (ldef D P) Lines :-
  lin-base K Base B K1, Fn is B ^ Lin, pp-ldef Fn D L1,
  (pi f\ lfname f Fn ==> pp-prog Lin K1 "" (P f) L2),
  pp-sep L1 L2 Lines.

% [lin-base K Base B K1] B is the name of a linear function: Base, the name of
% the non-linear function just before it, or fn-name K when Base is "". K1 is
% the index of the next fresh name.
func lin-base int, string -> string, int.
lin-base K "" B K1 :- !, fn-name K B, K1 is K + 1.
lin-base K B B K.

% [prog->string P S] S prints the program P, its lines joined by newlines;
% linear functions are named f.lin.
func prog->string prog -> string.
prog->string P S :- pp-prog ".lin" 0 "" P L, std.string.concat "\n" L S.

% [tprog->string P S] S prints the program P, an output of
% transpose.transpose-prog, its lines joined by newlines; linear functions are
% named f.linᵀ.
func tprog->string prog -> string.
tprog->string P S :- pp-prog ".linᵀ" 0 "" P L, std.string.concat "\n" L S.

} % namespace ppB
