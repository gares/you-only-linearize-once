% Examples
%
% Linear A terms (namespace example) and Linear B terms (exampleB).

accumulate linA.
accumulate linB.

% ---------------------------------------------------------------------------
% Examples
% ---------------------------------------------------------------------------

namespace example {

shorten linA.{
  ty, r, tup, val, real, vtup, nl, lin, fn, nbind, nb, nend, lbind, lb, lend,
  expr, ret, let, unpack, lunpack, app, nvar, lit, tuple, plus, mul, lvar,
  lzero, ltuple, lplus, lmul, dup, drop, fbody, body, prog, def, pnil }.
shorten linA.{ sin, cos, exp, neg }.

% [g D] D is g(x ; ẏ) = (x² ; x²ẏ), from Section 4.1:
%   def g(x:R ; ẏ:R) -> (R ; R) =
%     let (a:R ;) = x * x in
%     let (; ḃ:R) = a * ẏ in
%     (a ; ḃ)
func g -> nbind fbody.
g (nb r x\ nend (lb r y\ lend (body [r] [r]
  (let (mul x x) (nb r a\ nend (lend
  (let (lmul a y) (nend (lb r b\ lend
  (ret [a] [b])))))))))).

% [bad-twice D] D is ill-typed: ẏ is used twice.
func bad-twice -> nbind fbody.
bad-twice (nb r x\ nend (lb r y\ lend (body [r] [r, r]
  (ret [x] [y, y])))).

% [bad-unused D] D is ill-typed: x is never used (it should be dropped).
func bad-unused -> nbind fbody.
bad-unused (nb r x\ nend (lb r y\ lend (body [] [r]
  (ret [] [y])))).

% [drop-dup D] D is well-typed: x is dropped explicitly, ẏ is duplicated
% explicitly.
func drop-dup -> nbind fbody.
drop-dup (nb r x\ nend (lb r y\ lend (body [] [r, r]
  (let (drop (nvar x)) (nend (lend
  (let (dup y) (nend (lb r y1\ lb r y2\ lend
  (ret [] [y1, y2])))))))))).

% [swap D] D splits a non-linear pair and a linear pair with unpacking lets:
%   def swap(p:⊗(R,R) ; q̇:⊗(R,R)) -> (R,R ; R,R) =
%     let (⊗(a,b) ;) = p in let (; ⊗(ċ,ḋ)) = q̇ in (b,a ; ḋ,ċ)
func swap -> nbind fbody.
swap (nb (tup [r,r]) p\ nend (lb (tup [r,r]) q\ lend
  (body [r,r] [r,r]
  (unpack p (nb r a\ nb r b\ nend (lend
  (lunpack q (lb r c\ lb r d\ lend
  (ret [b,a] [d,c]))))))))).

% [g-prog P] P is a program calling g after its definition.
func g-prog -> prog.
g-prog P :-
  g G,
  P = def G f\
      def (nb r x\ nend (lb r y\ lend (body [r] [r] (app f [x] [y])))) _\
      pnil.

% [dsin D] D is the forward derivative of sin, as J would produce it:
%   def dsin(x:R ; ẋ:R) -> (R ; R) =
%     let (s:R ;) = sin(x) in let (c:R ;) = cos(x) in
%     let (; ḋ:R) = c * ẋ in (s ; ḋ)
func dsin -> nbind fbody.
dsin (nb r x\ nend (lb r dx\ lend (body [r] [r]
  (let (sin x) (nb r s\ nend (lend
  (let (cos x) (nb r c\ nend (lend
  (let (lmul c dx) (nend (lb r d\ lend
  (ret [s] [d]))))))))))))).

% --- Inputs to forward.dj: purely non-linear definitions ----------------------

% [neg-sin D] D is f(u) = −sin(u), the running example of the paper (Figure 6):
%   def f(u:R ;) -> (R ;) = let (v:R ;) = sin(u) in let (w:R ;) = −v in (w ;)
func neg-sin -> nbind fbody.
neg-sin (nb r u\ nend (lend (body [r] []
  (let (sin u) (nb r v\ nend (lend
  (let (neg v) (nb r w\ nend (lend
  (ret [w] [])))))))))).

% [neg-sin-J D] D is J(neg-sin) after flatten and copyprop, as in Figure 6,
% right. Linear A has no linear negation, so −v̇ is -1.0 * v̇.
%   def f^J(u:R ; u̇:R) -> (R ; R) =
%     let (v ;) = sin(u) in let (du ;) = cos(u) in let (; v̇) = du * u̇ in
%     let (w ;) = −v in let (m ;) = -1.0 in let (; ẇ) = m * v̇ in (w ; ẇ)
func neg-sin-J -> nbind fbody.
neg-sin-J (nb r u\ nend (lb r du\ lend (body [r] [r]
  (let (sin u) (nb r v\ nend (lend
  (let (cos u) (nb r c\ nend (lend
  (let (lmul c du) (nend (lb r dv\ lend
  (let (neg v) (nb r w\ nend (lend
  (let (lit -1.0) (nb r m\ nend (lend
  (let (lmul m dv) (nend (lb r dw\ lend
  (ret [w] [dw])))))))))))))))))))))).

% [sin1 D] D is sin1(u) = sin(u): its derivative unzips to Figure 9
% (exampleB.dsin-unzipped).
func sin1 -> nbind fbody.
sin1 (nb r x\ nend (lend (body [r] [] (sin x)))).

% [sq D] D is sq(x) = x * x: x is used twice, so its tangent is dup-ed.
func sq -> nbind fbody.
sq (nb r x\ nend (lend (body [r] [] (mul x x)))).

% [h D] D is h(x) = let s = sin(x) in let p = x * s in exp(p), where x is free
% in both the bound expression and the body of the first let.
func h -> nbind fbody.
h (nb r x\ nend (lend (body [r] []
  (let (sin x) (nb r s\ nend (lend
  (let (mul x s) (nb r p\ nend (lend
  (exp p)))))))))).

% [m D] D is m below, where p is used after unpacking it (rule JUnpackB) and
% 2.0 uses rule JLit:
% m(p : ⊗(R,R)) = let (⊗(a,b) ;) = p in let c = a * b in
%                 let w = 2.0 in let d = c * w in (d, p ;)
func m -> nbind fbody.
m (nb (tup [r,r]) p\ nend (lend (body [r, tup [r,r]] []
  (unpack p (nb r a\ nb r b\ nend (lend
  (let (mul a b) (nb r c\ nend (lend
  (let (lit 2.0) (nb r w\ nend (lend
  (let (mul c w) (nb r d\ nend (lend
  (ret [d, p] [])))))))))))))))).

% [k-prog P] P is a program: sq, then k(x) = let y = sq(x) in y + x.
func k-prog -> prog.
k-prog P :-
  sq Sq,
  P = def Sq f\
      def (nb r x\ nend (lend (body [r] []
            (let (app f [x] []) (nb r y\ nend (lend (plus y x))))))) _\
      pnil.

% --- Input to erase.lerase-prog: linear +, * and 0̇ at a tuple type -----------

% [lin-tup D] D uses linear +, * and 0̇ at a tuple type:
%   def lt(; ẋ:⊗(R,R)) -> (; ⊗(R,R)) =
%     let (; ż) = 0̇_⊗(R,R) in let (; ṡ) = ẋ + ż in
%     let (w ;) = 2.0 in let (; ṫ) = w * ṡ in (; ṫ)
func lin-tup -> nbind fbody.
lin-tup (nend (lb (tup [r,r]) x\ lend (body [] [tup [r,r]]
  (let (lzero (tup [r,r])) (nend (lb (tup [r,r]) z\ lend
  (let (lplus x z) (nend (lb (tup [r,r]) s\ lend
  (let (lit 2.0) (nb r w\ nend (lend
  (let (lmul w s) (nend (lb (tup [r,r]) u\ lend
  (ret [] [u])))))))))))))))).

} % namespace example

namespace exampleB {

shorten linA.{ r, tup }.
shorten linB.{
  nb, nend, lb, lend, ret, let, leaf, lret, llet, nunpack, lleaf,
  nbody, lbody, ndef, ldef, pnil }.

% [dsin-nonlin D] D is the non-linear part of example.dsin unzipped as in Figure
% 9: it computes sin x and returns the tape ⊗(cos x). The linear part, dsin-lin,
% reads the tape:
%   def f.nonlin(x:R ;) -> (R, ⊗(R) ;) =
%     let (s:R ;) = sin(x) in let (c:R ;) = cos(x) in
%     let (t:⊗(R) ;) = ⊗(c) in (s, t ;)
%   def f.lin(t:⊗(R) ; ẋ:R) -> (; R) =
%     let (⊗(c) ;) = t in let (; ḋ:R) = c * ẋ in (; ḋ)
func dsin-nonlin -> linB.nabs linB.nfbody.
dsin-nonlin (nb r x\ nend (nbody [r, tup [r]]
  (let (leaf (linA.sin x)) (nb r s\ nend
  (let (leaf (linA.cos x)) (nb r c\ nend
  (let (leaf (linA.tuple [c])) (nb (tup [r]) t\ nend
  (ret [s, t]))))))))).

% [dsin-lin D] D is the linear part of example.dsin unzipped, f.lin above.
func dsin-lin -> linB.nabs (linB.labs linB.lfbody).
dsin-lin (nb (tup [r]) t\ nend (lb r dx\ lend (lbody [r]
  (nunpack t (nb r c\ nend
  (llet (lleaf (linA.lmul c dx)) (lb r d\ lend
  (lret [d])))))))).

% [dsin-unzipped P] P is dsin-nonlin and dsin-lin in one program: the entry
% point (the last definition) is f.lin.
func dsin-unzipped -> linB.prog.
dsin-unzipped (ndef N _\ ldef L _\ pnil) :- dsin-nonlin N, dsin-lin L.

} % namespace exampleB
